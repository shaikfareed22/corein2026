# FOMO Cloud on AWS with Google Gemini for every account. bootstrap.sh fills the
# placeholders and writes the result to cloud/.env (mode 0600). Never commit .env.
# Every setting is explained in cloud/README.md ("Settings").

# --- where the relay is reached ---------------------------------------------------------
CLOUD_DOMAIN=${DOMAIN}
PUBLIC_BASE=https://${DOMAIN}
ACME_EMAIL=${ACME_EMAIL}
RELAY_BIND=0.0.0.0

# --- secrets: made once, kept across re-runs, backed up with the database -----------------
CLOUD_SECRET=${CLOUD_SECRET}
CLOUD_ADMIN_TOKEN=${CLOUD_ADMIN_TOKEN}

# --- the model provider: Google's OpenAI-compatible layer, the operator's key ------------
UPSTREAM_BASE=https://generativelanguage.googleapis.com/v1beta/openai
UPSTREAM_KEY=${UPSTREAM_KEY}
# Gemini rejects Model Studio's enable_thinking, so nothing is merged into chat requests,
# and the two ways an app says "no thinking" (the hands do, on every screenshot step) are
# taken out before the request goes to Google, which answers 400 to both.
CHAT_DEFAULTS={}
CHAT_DROP={"enable_thinking": true, "reasoning_effort": ["none"]}
# Gemini 3 refuses a history whose earlier tool calls lack the thought signature it gave
# them; the apps keep none, and Google accepts this placeholder in their place.
CHAT_TOOL_CALL_SIGNATURE=skip_thought_signature_validator
# The menu below is the whole offer: no reading of the provider's /models list.
CLOUD_MODELS=${CLOUD_MODELS}
CLOUD_CATALOG=0
CLOUD_ANY_MODEL_MEMBERS=1
UPSTREAM_TIMEOUT_S=180
MAX_IN_FLIGHT=4

# --- who may sign in, and how much they get ------------------------------------------------
SIGNUP_OPEN=1
ALLOWED_IDENTIFIERS=${OPERATOR_EMAIL}
ALLOWANCE_CNY=10
INVITE_BONUS_CNY=5
INVITE_URL=https://${DOMAIN}/app/?invite=
OWN_KEY_DOCS=https://fomo.corein.in/own-key
OPENROUTER_URL=https://openrouter.ai/keys
SIGNUP_TOKENS=0
DAILY_CAP_TOKENS=0
PER_MINUTE_REQUESTS=30
IMPROVE_DEFAULT=0
PRIVACY_URL=https://fomo.corein.in/privacy/
DAY_OFFSET_H=0
USD_CNY=7.1

# --- sign-in codes by e-mail -------------------------------------------------------------
CODE_SENDER=smtp
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=${SMTP_PORT}
SMTP_USER=${SMTP_USER}
SMTP_PASSWORD=${SMTP_PASSWORD}
SMTP_FROM=${SMTP_FROM}
ADMIN_EMAIL=${OPERATOR_EMAIL}

# --- the hub (devices find each other) and the web console at /app ------------------------
HUB_ENABLED=true

# --- optional: a webhook selfcheck.sh posts problems to ({"text": ...}) --------------------
ALERT_URL=
