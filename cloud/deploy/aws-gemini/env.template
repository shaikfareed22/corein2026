# FOMO Cloud on AWS with one provider key (M4 Spider by default) for every account. bootstrap.sh fills the
# placeholders and writes the result to cloud/.env (mode 0600). Never commit .env.
# Every setting is explained in cloud/README.md ("Settings").

# --- where the relay is reached ---------------------------------------------------------
CLOUD_DOMAIN=${DOMAIN}
PUBLIC_BASE=https://${DOMAIN}
ACME_EMAIL=${ACME_EMAIL}
RELAY_BIND=0.0.0.0

# --- secrets: made once, kept across re-runs, backed up with the database -----------------
CLOUD_SECRET=${CLOUD_SECRET}
CLOUD_ADMIN_TOKEN=${CLOUD_ADMIN_TOKEN}

# --- the model provider: M4 Spider's OpenAI-style door, the operator's key ----------------
# Both can be changed while the relay runs, from the admin page (Settings → Model provider),
# with a Test button that asks the provider before anything is saved. Pointing the relay
# at Google instead: UPSTREAM_BASE=https://generativelanguage.googleapis.com/v1beta/openai,
# an AIza… key, CHAT_DROP={"enable_thinking": true, "reasoning_effort": ["none"]},
# CHAT_TOOL_CALL_SIGNATURE=skip_thought_signature_validator, and a Gemini menu.
UPSTREAM_BASE=https://admin.m4spider.com/v1
UPSTREAM_KEY=${UPSTREAM_KEY}
# Nothing is merged into chat requests. Model Studio's enable_thinking is taken out; the
# other no-thinking field, reasoning_effort "none" (the hands send it on every screenshot
# step), M4 Spider honours — its models think for hundreds of hidden tokens otherwise.
CHAT_DEFAULTS={}
CHAT_DROP={"enable_thinking": true}
CHAT_TOOL_CALL_SIGNATURE=
# A busy model (429, 5xx) is asked again up to five times, waiting as long as the provider
# says (20 s at most each time); the last try goes to Qwen, whose quota is counted apart.
# M4 Spider's plans are request quotas per model per five hours ("auto" has none on Pro).
CHAT_RETRIES=5
CHAT_RETRY_MAX_S=20
CHAT_FALLBACK=qwen/qwen3.8-flash
# The menu below is the whole offer: no reading of the provider's /models list.
CLOUD_MODELS=${CLOUD_MODELS}
CLOUD_CATALOG=0
CLOUD_ANY_MODEL_MEMBERS=1
UPSTREAM_TIMEOUT_S=180
MAX_IN_FLIGHT=4

# --- who may sign in, and how much they get ------------------------------------------------
# Everything priced below is in Indian rupees: the menu's prices per million tokens, the
# allowance, the invite bonus (the `_CNY` in the names is the ledger's history, not a
# conversion). M4 Spider bills a flat plan, not tokens: the menu's prices only pace each
# account's allowance (₹100 ≈ a few thousand screenshot steps), they are not a bill. USD_CNY is rupees to the US dollar, for the dollar figure shown beside each
# amount. The allowance and the bonus can also be changed on the admin page while it runs.
CURRENCY=INR
SIGNUP_OPEN=1
ALLOWED_IDENTIFIERS=${OPERATOR_EMAIL}
ALLOWANCE_CNY=100
INVITE_BONUS_CNY=50
INVITE_URL=https://${DOMAIN}/app/?invite=
OWN_KEY_DOCS=https://fomo.corein.in/own-key
OPENROUTER_URL=https://openrouter.ai/keys
SIGNUP_TOKENS=0
DAILY_CAP_TOKENS=0
PER_MINUTE_REQUESTS=30
IMPROVE_DEFAULT=0
PRIVACY_URL=https://fomo.corein.in/docs/privacy
TERMS_URL=https://fomo.corein.in/docs/terms
# where the apps' "Report this reply" goes when the person has no account to send it with,
# and the address the store listing names; the admin page's Reports tab gets the rest
SUPPORT_EMAIL=supportcorein@corein.in
DAY_OFFSET_H=0
USD_CNY=84

# --- sign-in codes by e-mail -------------------------------------------------------------
CODE_SENDER=smtp
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=${SMTP_PORT}
SMTP_USER=${SMTP_USER}
SMTP_PASSWORD=${SMTP_PASSWORD}
SMTP_FROM=${SMTP_FROM}
ADMIN_EMAIL=${OPERATOR_EMAIL}

# --- the hub (devices find each other) and the web console at /app ------------------------
HUB_ENABLED=true

# --- optional: a webhook selfcheck.sh posts problems to ({"text": ...}) --------------------
ALERT_URL=
